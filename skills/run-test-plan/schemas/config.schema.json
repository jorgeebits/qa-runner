{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-test-plan/config.schema.json",
  "title": "Project config (.qa/config.json)",
  "description": "Everything project-specific lives here, so the plugin itself stays generic. Every field is optional.",
  "type": "object",
  "properties": {
    "runsDir": {
      "type": "string",
      "default": ".qa/runs",
      "description": "Relative to the project root. Keep it out of version control."
    },
    "plansDir": {
      "type": "string",
      "default": ".qa/plans"
    },
    "viewerPort": {
      "type": "integer",
      "default": 4321
    },
    "tracker": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Jira",
            "GitHub",
            "Linear"
          ]
        },
        "issueUrl": {
          "type": "string",
          "description": "Link template; {key} is replaced by the issue key.",
          "examples": [
            "https://example.atlassian.net/browse/{key}",
            "https://github.com/org/repo/issues/{key}"
          ]
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Display label per target key.",
      "default": {
        "app": "App under test",
        "reference": "Reference app"
      }
    },
    "variants": {
      "type": "object",
      "description": "Axes test cases fork on. When present, plans are checked against it.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed values; omit for free text."
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Project skills a Test Agent may invoke on demand, by purpose: login, navigate, fileBug\u2026",
      "examples": [
        {
          "login": "my-login-skill",
          "fileBug": "create-bug-ticket"
        }
      ]
    },
    "memory": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "default": ".qa/memory",
          "description": "Project memory folder; commit it so the team shares what agents learned."
        },
        "briefLimit": {
          "type": "integer",
          "default": 10,
          "description": "Most memory pointers per brief."
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "blurPersonalData": {
          "type": "boolean",
          "default": false,
          "description": "Ask Test Agents to blur names, IDs, phones and addresses in screenshots. Turn on only for environments that show real customer data."
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Per-model overrides of the list prices in scripts/pricing.mjs, in USD per million tokens.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "type": "number"
          },
          "output": {
            "type": "number"
          },
          "cacheRead": {
            "type": "number"
          },
          "cacheWrite5m": {
            "type": "number"
          },
          "cacheWrite1h": {
            "type": "number"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "How Test Agents are scheduled: parallel browsers, accounts, batch size and model routing.",
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 3,
          "description": "Batches running at once, each in its own browser of the plugin's pool."
        },
        "sessions": {
          "enum": [
            "exclusive",
            "shared"
          ],
          "default": "exclusive",
          "description": "exclusive: a login ends the user's other sessions, so each running batch needs its own account. shared: one user may be logged in from several browsers."
        },
        "accounts": {
          "type": "array",
          "description": "Logins Test Agents may use. Without it, the plan's environment.user is the only one.",
          "items": {
            "type": "object",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "type": "string"
              },
              "secret": {
                "type": "string",
                "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$",
                "description": "Where the password is, as env:NAME. Never the password itself."
              },
              "variants": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Only batches with these variant values may use this account (a store-bound user, say)."
              }
            }
          }
        },
        "maxCasesPerAgent": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Longer groups are split into batches run in order by fresh agents, because every turn re-reads the agent's whole context."
        },
        "tiers": {
          "type": "object",
          "description": "Model and effort per tier; see references/execute.md.",
          "properties": {
            "simple": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            },
            "standard": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            },
            "complex": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            }
          },
          "default": {
            "simple": {
              "model": "haiku",
              "effort": "medium"
            },
            "standard": {
              "model": "sonnet",
              "effort": "medium"
            },
            "complex": {
              "model": "sonnet",
              "effort": "high"
            }
          }
        },
        "escalate": {
          "type": "boolean",
          "default": true,
          "description": "Re-run once on the standard tier any case a haiku batch reports as fail, blocked, unfinished or with contract warnings."
        }
      }
    }
  }
}
